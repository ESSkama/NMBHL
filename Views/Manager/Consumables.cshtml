@{
    ViewData["Title"] = "Consumables";
    ViewData["Active"] = "Consumables";
    Layout = "~/Views/Manager/_ManagerLayout.cshtml";
}

<div class="card">
    <div class="card-header-gold d-flex justify-content-between align-items-center">
        <span><i class="fas fa-boxes me-2"></i>Consumable Stock</span>
        <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#addConsumableModal">
            <i class="fas fa-plus me-1"></i>Add Consumable
        </button>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4"><input type="text" class="form-control" placeholder="Search consumables..." /></div>
        </div>
        <table class="table table-hover">
            <thead>
                <tr><th>Consumable Name</th><th>Supplier</th><th>Qty On Hand</th><th>Reorder Level</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td>EDTA Tubes</td>
                    <td>MedSupply SA</td>
                    <td><span class="badge bg-danger">18</span></td>
                    <td>20</td>
                    <td><span class="badge bg-danger">Below Reorder</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-success me-1" data-bs-toggle="modal" data-bs-target="#adjustModal"><i class="fas fa-sliders-h"></i> Adjust</button>
                        <button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>Microscope Slides</td>
                    <td>LabCo</td>
                    <td><span class="badge bg-warning text-dark">22</span></td>
                    <td>25</td>
                    <td><span class="badge bg-warning text-dark">Near Reorder</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-success me-1" data-bs-toggle="modal" data-bs-target="#adjustModal"><i class="fas fa-sliders-h"></i> Adjust</button>
                        <button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>Staining Reagent</td>
                    <td>MedSupply SA</td>
                    <td><span class="badge bg-success">45</span></td>
                    <td>10</td>
                    <td><span class="badge bg-success">In Stock</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-success me-1" data-bs-toggle="modal" data-bs-target="#adjustModal"><i class="fas fa-sliders-h"></i> Adjust</button>
                        <button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>Citrate Tubes</td>
                    <td>PathLab Supplies</td>
                    <td><span class="badge bg-success">60</span></td>
                    <td>15</td>
                    <td><span class="badge bg-success">In Stock</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-success me-1" data-bs-toggle="modal" data-bs-target="#adjustModal"><i class="fas fa-sliders-h"></i> Adjust</button>
                        <button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Adjust Stock Modal -->
<div class="modal fade" id="adjustModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#F5A800;">
                <h5 class="modal-title text-white"><i class="fas fa-sliders-h me-2"></i>Adjust Stock Level</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Consumable: <strong>EDTA Tubes</strong> | Current Qty: <strong>18</strong></p>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Adjustment Type</label>
                    <select class="form-select">
                        <option>Increase quantity by</option>
                        <option>Decrease quantity by</option>
                        <option>Set quantity to</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Value</label>
                    <input type="number" class="form-control" placeholder="Enter value" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-gold">Apply Adjustment</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Consumable Modal -->
<div class="modal fade" id="addConsumableModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#F5A800;">
                <h5 class="modal-title text-white"><i class="fas fa-plus me-2"></i>Add Consumable</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Consumable Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="Enter consumable name" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Supplier <span class="text-danger">*</span></label>
                    <select class="form-select">
                        <option>Select supplier...</option>
                        <option>MedSupply SA</option>
                        <option>LabCo</option>
                        <option>PathLab Supplies</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Reorder Level <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" placeholder="Enter reorder level" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Initial Quantity on Hand</label>
                    <input type="number" class="form-control" placeholder="Enter quantity" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-gold">Save Consumable</button>
            </div>
        </div>
    </div>
</div>