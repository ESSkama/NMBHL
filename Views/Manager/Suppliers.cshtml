@{
    ViewData["Title"] = "Suppliers";
    ViewData["Active"] = "Suppliers";
    Layout = "~/Views/Manager/_ManagerLayout.cshtml";
}

<div class="card">
    <div class="card-header-gold d-flex justify-content-between align-items-center">
        <span><i class="fas fa-truck me-2"></i>Suppliers</span>
        <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#addSupplierModal">
            <i class="fas fa-plus me-1"></i>Add Supplier
        </button>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead><tr><th>Supplier Name</th><th>Contact Person</th><th>Email</th><th>Consumables Supplied</th><th>Actions</th></tr></thead>
            <tbody>
                <tr><td>MedSupply SA</td><td>John Smith</td><td>john@medsupply.co.za</td><td><span class="badge bg-primary">5</span></td><td><button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button><button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></td></tr>
                <tr><td>LabCo</td><td>Sarah Johnson</td><td>sarah@labco.co.za</td><td><span class="badge bg-primary">3</span></td><td><button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button><button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></td></tr>
                <tr><td>PathLab Supplies</td><td>Mike van der Berg</td><td>mike@pathlab.co.za</td><td><span class="badge bg-primary">4</span></td><td><button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button><button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="addSupplierModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#F5A800;">
                <h5 class="modal-title text-white"><i class="fas fa-plus me-2"></i>Add Supplier</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Supplier Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="Enter supplier name" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Contact Person</label>
                    <input type="text" class="form-control" placeholder="Enter contact person name" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" placeholder="Enter email address" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-gold">Save Supplier</button>
            </div>
        </div>
    </div>
</div>
