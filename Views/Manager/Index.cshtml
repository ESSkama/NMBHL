                <table class="table mb-0">
                    <thead><tr><th>Consumable</th><th>On Hand</th><th>Reorder Level</th><th>Action</th></tr></thead>
                    <tbody>
                        <tr>
                            <td>EDTA Tubes</td>
                            <td><span class="badge bg-danger">18</span></td>
                            <td>20</td>
                            <td><a href="/Manager/Orders" class="btn btn-sm btn-gold">Order</a></td>
                        </tr>
                        <tr>
                            <td>Microscope Slides</td>
                            <td><span class="badge bg-warning text-dark">22</span></td>
                            <td>25</td>
                            <td><a href="/Manager/Orders" class="btn btn-sm btn-gold">Order</a></td>
                        </tr>
                        <tr>
                            <td>Staining Reagent</td>
                            <td><span class="badge bg-danger">5</span></td>
                            <td>10</td>
                            <td><a href="/Manager/Orders" class="btn btn-sm btn-gold">Order</a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header-gold"><i class="fas fa-shopping-cart me-2"></i>Recent Orders</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>Order #</th><th>Supplier</th><th>Date</th><th>Status</th></tr></thead>
                    <tbody>
                        <tr>
                            <td>ORD-001</td>
