@{
    ViewData["Title"] = "Dashboard";
    ViewData["Active"] = "Dashboard";
    Layout = "~/Views/Manager/_ManagerLayout.cshtml";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#F5A800,#e09500);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:0.8rem;opacity:0.85;">Total Test Types</div>
                    <div style="font-size:2rem;font-weight:700;">24</div>
                </div>
                <i class="fas fa-vials fa-2x" style="opacity:0.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#0d6efd,#0b5ed7);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:0.8rem;opacity:0.85;">Registered Doctors</div>
                    <div style="font-size:2rem;font-weight:700;">12</div>
                </div>
                <i class="fas fa-user-md fa-2x" style="opacity:0.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#198754,#157347);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:0.8rem;opacity:0.85;">Lab Technicians</div>
                    <div style="font-size:2rem;font-weight:700;">8</div>
                </div>
                <i class="fas fa-user-cog fa-2x" style="opacity:0.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#dc3545,#bb2d3b);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:0.8rem;opacity:0.85;">Low Stock Alerts</div>
                    <div style="font-size:2rem;font-weight:700;">3</div>
                </div>
                <i class="fas fa-exclamation-triangle fa-2x" style="opacity:0.4;"></i>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
