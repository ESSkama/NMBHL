@{
    ViewData["Title"] = "Test Types";
    ViewData["Active"] = "TestTypes";
    Layout = "~/Views/Manager/_ManagerLayout.cshtml";
}

<div class="card">
    <div class="card-header-gold d-flex justify-content-between align-items-center">
        <span><i class="fas fa-vials me-2"></i>Test Types</span>
        <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#addTestModal">
            <i class="fas fa-plus me-1"></i>Add Test Type
        </button>
    </div>
    <div class="card-body">
        <div class="row mb-3 g-2">
            <div class="col-md-4"><input type="text" class="form-control" placeholder="Search test types..." /></div>
            <div class="col-md-3">
                <select class="form-select">
                    <option>All Categories</option>
                    <option>Full Blood Count</option>
                    <option>Differential Count</option>
                    <option>Coagulation Studies</option>
                </select>
            </div>
        </div>
        <table class="table table-hover">
            <thead>
                <tr><th>Test Name</th><th>Category</th><th>Sample Type</th><th>Unit</th><th>Normal Range</th><th>TAT (min)</th><th>Assigned Technicians</th><th>Actions</th></tr>
            </thead>
            <tbody>
                <tr><td>Haemoglobin</td><td>Full Blood Count</td><td>Whole Blood</td><td>g/dL</td><td>12.0 - 17.5</td><td>30</td><td><span class="badge bg-success">3</span></td><td><button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button><button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></td></tr>
                <tr><td>Platelet Count</td><td>Full Blood Count</td><td>Whole Blood</td><td>x10³/µL</td><td>150 - 400</td><td>30</td><td><span class="badge bg-success">3</span></td><td><button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button><button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></td></tr>
                <tr><td>WBC Count</td><td>Differential Count</td><td>Whole Blood</td><td>x10³/µL</td><td>4.5 - 11.0</td><td>45</td><td><span class="badge bg-warning text-dark">2</span></td><td><button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button><button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></td></tr>
                <tr><td>PT/INR</td><td>Coagulation Studies</td><td>Plasma</td><td>seconds</td><td>11 - 13.5</td><td>60</td><td><span class="badge bg-warning text-dark">2</span></td><td><button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button><button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></td></tr>
                <tr><td>Blood Film Exam</td><td>Peripheral Blood Film</td><td>Whole Blood</td><td>N/A</td><td>Normal Morphology</td><td>90</td><td><span class="badge bg-danger">1</span></td><td><button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button><button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="addTestModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:#F5A800;">
                <h5 class="modal-title text-white"><i class="fas fa-plus me-2"></i>Add Test Type</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Test Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="Enter test name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                        <select class="form-select">
                            <option>Select category...</option>
                            <option>Full Blood Count</option>
                            <option>Differential Count</option>
                            <option>Peripheral Blood Film</option>
                            <option>Coagulation Studies</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Sample Type <span class="text-danger">*</span></label>
                        <select class="form-select">
                            <option>Select sample type...</option>
                            <option>Whole Blood</option>
                            <option>Plasma</option>
                            <option>Bone Marrow</option>
                            <option>Serum</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Unit of Measurement</label>
                        <select class="form-select">
                            <option>Select unit...</option>
                            <option>g/dL</option>
                            <option>x10³/µL</option>
                            <option>µL</option>
                            <option>g/L</option>
                            <option>k/µL</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Normal Range Min</label>
                        <input type="number" class="form-control" placeholder="Min" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Normal Range Max</label>
                        <input type="number" class="form-control" placeholder="Max" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Turnaround Time (minutes)</label>
                        <input type="number" class="form-control" placeholder="e.g. 30" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Consumables Used</label>
                        <select class="form-select" multiple style="height:90px;">
                            <option>EDTA Tubes</option>
                            <option>Microscope Slides</option>
                            <option>Staining Reagent</option>
                            <option>Citrate Tubes</option>
                        </select>
                        <small class="text-muted">Hold Ctrl to select multiple</small>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-gold">Save Test Type</button>
            </div>
        </div>
    </div>
</div>
