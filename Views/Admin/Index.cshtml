@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["Active"] = "Dashboard";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card" style="background:linear-gradient(135deg,#dc3545,#bb2d3b);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:0.8rem;opacity:0.85;">Medical Conditions</div>
                    <div style="font-size:2rem;font-weight:700;">24</div>
                    <div style="font-size:0.75rem;opacity:0.75;">across 4 categories</div>
                </div>
                <i class="fas fa-notes-medical fa-2x" style="opacity:0.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="background:linear-gradient(135deg,#fd7e14,#e06b00);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:0.8rem;opacity:0.85;">Allergies</div>
                    <div style="font-size:2rem;font-weight:700;">18</div>
                    <div style="font-size:0.75rem;opacity:0.75;">across 3 categories</div>
                </div>
                <i class="fas fa-allergies fa-2x" style="opacity:0.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="background:linear-gradient(135deg,#6f42c1,#5a35a8);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:0.8rem;opacity:0.85;">Medications</div>
                    <div style="font-size:2rem;font-weight:700;">42</div>
                    <div style="font-size:0.75rem;opacity:0.75;">across 6 categories</div>
                </div>
                <i class="fas fa-pills fa-2x" style="opacity:0.4;"></i>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header-red">
                <i class="fas fa-notes-medical me-2"></i>Condition Categories
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>Category</th><th>Count</th></tr></thead>
                    <tbody>
                        <tr><td>Cardiovascular</td><td><span class="badge bg-danger">6</span></td></tr>
                        <tr><td>Endocrine</td><td><span class="badge bg-danger">5</span></td></tr>
                        <tr><td>Respiratory</td><td><span class="badge bg-danger">7</span></td></tr>
                        <tr><td>Infectious Disease</td><td><span class="badge bg-danger">6</span></td></tr>
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white border-0">
                <a href="/Admin/Conditions" class="btn btn-red btn-sm w-100">Manage Conditions</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header-red" style="background:#fd7e14;">
                <i class="fas fa-allergies me-2"></i>Allergy Categories
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>Category</th><th>Count</th></tr></thead>
                    <tbody>
                        <tr><td>Drug Allergies</td><td><span class="badge bg-warning text-dark">8</span></td></tr>
                        <tr><td>Environmental</td><td><span class="badge bg-warning text-dark">5</span></td></tr>
                        <tr><td>Material</td><td><span class="badge bg-warning text-dark">5</span></td></tr>
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white border-0">
                <a href="/Admin/Allergies" class="btn btn-sm w-100" style="background:#fd7e14;color:white;">Manage Allergies</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header-red" style="background:#6f42c1;">
                <i class="fas fa-pills me-2"></i>Medication Categories
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>Category</th><th>Count</th></tr></thead>
                    <tbody>
                        <tr><td>Antidiabetics</td><td><span class="badge bg-purple" style="background:#6f42c1;">8</span></td></tr>
                        <tr><td>Antihypertensives</td><td><span class="badge bg-purple" style="background:#6f42c1;">10</span></td></tr>
                        <tr><td>Antibiotics</td><td><span class="badge bg-purple" style="background:#6f42c1;">12</span></td></tr>
                        <tr><td>Anticoagulants</td><td><span class="badge bg-purple" style="background:#6f42c1;">6</span></td></tr>
                        <tr><td>Analgesics</td><td><span class="badge bg-purple" style="background:#6f42c1;">4</span></td></tr>
                        <tr><td>Other</td><td><span class="badge bg-purple" style="background:#6f42c1;">2</span></td></tr>
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white border-0">
                <a href="/Admin/Medication" class="btn btn-sm w-100" style="background:#6f42c1;color:white;">Manage Medication</a>
            </div>
        </div>
    </div>
</div>