@{
    ViewData["Title"] = "Medical Conditions";
    ViewData["Active"] = "Conditions";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div class="row g-4">
    <!-- Categories Panel -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header-red d-flex justify-content-between align-items-center">
                <span><i class="fas fa-folder me-2"></i>Categories</span>
                <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#addCatModal">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    <a href="#" class="list-group-item list-group-item-action active d-flex justify-content-between align-items-center" style="background:#dc3545;border-color:#dc3545;">
                        Cardiovascular
                        <span class="badge bg-light text-dark">6</span>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        Endocrine
                        <span class="badge bg-danger">5</span>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        Respiratory
                        <span class="badge bg-danger">7</span>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        Infectious Disease
                        <span class="badge bg-danger">6</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Conditions Panel -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header-red d-flex justify-content-between align-items-center">
                <span><i class="fas fa-notes-medical me-2"></i>Conditions — Cardiovascular</span>
                <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#addCondModal">
                    <i class="fas fa-plus me-1"></i>Add Condition
                </button>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <input type="text" class="form-control" placeholder="Search conditions..." />
                    </div>
                </div>
                <table class="table table-hover">
                    <thead><tr><th>Condition Name</th><th>Description</th><th>Patients</th><th>Actions</th></tr></thead>
                    <tbody>
                        <tr>
                            <td>Hypertension</td>
                            <td>High blood pressure condition</td>
                            <td><span class="badge bg-primary">14</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td>Heart Failure</td>
                            <td>Chronic heart failure condition</td>
                            <td><span class="badge bg-primary">8</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td>Atrial Fibrillation</td>
                            <td>Irregular heart rhythm disorder</td>
                            <td><span class="badge bg-primary">5</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td>Coronary Artery Disease</td>
                            <td>Narrowing of the coronary arteries</td>
                            <td><span class="badge bg-primary">9</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td>Deep Vein Thrombosis</td>
                            <td>Blood clot in a deep vein</td>
                            <td><span class="badge bg-primary">3</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td>Anaemia</td>
                            <td>Deficiency of red blood cells</td>
                            <td><span class="badge bg-primary">11</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCatModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#dc3545;">
                <h5 class="modal-title text-white"><i class="fas fa-plus me-2"></i>Add Condition Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="e.g. Neurological" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Description</label>
                    <textarea class="form-control" rows="2" placeholder="Enter description..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-red">Save Category</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Condition Modal -->
<div class="modal fade" id="addCondModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#dc3545;">
                <h5 class="modal-title text-white"><i class="fas fa-plus me-2"></i>Add Medical Condition</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                    <select class="form-select">
                        <option selected>Cardiovascular</option>
                        <option>Endocrine</option>
                        <option>Respiratory</option>
                        <option>Infectious Disease</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Condition Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="Enter condition name" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Description</label>
                    <textarea class="form-control" rows="2" placeholder="Enter description..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-red">Save Condition</button>
            </div>
        </div>
    </div>
</div>