@{
    ViewData["Title"] = "Reports";
    ViewData["Active"] = "Reports";
    Layout = "~/Views/Patient/_PatientLayout.cshtml";
}

<div class="card">
    <div class="card-header-purple">
        <i class="fas fa-file-pdf me-2"></i>My Reports
    </div>
    <div class="card-body">
        <h6 class="fw-semibold mb-3">Generate Report</h6>
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Report Type</label>
                <select class="form-select">
                    <option>All Test Results by Category</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Date From</label>
                <input type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Date To</label>
                <input type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-purple w-100">
                    <i class="fas fa-file-pdf me-2"></i>Generate PDF Report
                </button>
            </div>
        </div>

        <hr class="my-4" />

        <h6 class="fw-semibold mb-3">Preview — My Results by Category</h6>
        <div class="mb-4">
            <h6 class="text-muted" style="font-size:0.85rem; text-transform:uppercase; letter-spacing:1px;">Full Blood Count</h6>
            <table class="table table-bordered table-sm">
                <thead><tr><th>Date</th><th>Test</th><th>Result</th><th>Unit</th><th>Flag</th></tr></thead>
                <tbody>
                    <tr class="abnormal"><td>2026-04-30</td><td>Haemoglobin</td><td>7.2</td><td>g/dL</td><td><span class="badge bg-danger">↓ LOW</span></td></tr>
                    <tr><td>2026-04-30</td><td>Platelet Count</td><td>220</td><td>x10³/µL</td><td><span class="badge bg-success">Normal</span></td></tr>
                </tbody>
            </table>
        </div>
        <div>
            <h6 class="text-muted" style="font-size:0.85rem; text-transform:uppercase; letter-spacing:1px;">Differential Count</h6>
            <table class="table table-bordered table-sm">
                <thead><tr><th>Date</th><th>Test</th><th>Result</th><th>Unit</th><th>Flag</th></tr></thead>
                <tbody>
                    <tr class="abnormal"><td>2026-04-29</td><td>WBC Count</td><td>14.5</td><td>x10³/µL</td><td><span class="badge bg-danger">↑ HIGH</span></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>