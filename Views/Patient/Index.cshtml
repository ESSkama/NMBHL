@{
    ViewData["Title"] = "My Dashboard";
    ViewData["Active"] = "Dashboard";
    Layout = "~/Views/Patient/_PatientLayout.cshtml";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#6f42c1,#5a35a8);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:0.8rem;opacity:0.85;">Total Requests</div>
                    <div style="font-size:2rem;font-weight:700;">8</div>
                </div>
                <i class="fas fa-file-medical fa-2x" style="opacity:0.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#fd7e14,#e06b00);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:0.8rem;opacity:0.85;">In Progress</div>
                    <div style="font-size:2rem;font-weight:700;">2</div>
                </div>
                <i class="fas fa-hourglass-half fa-2x" style="opacity:0.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#198754,#157347);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:0.8rem;opacity:0.85;">Results Available</div>
                    <div style="font-size:2rem;font-weight:700;">3</div>
                </div>
                <i class="fas fa-poll fa-2x" style="opacity:0.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#0d6efd,#0b5ed7);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:0.8rem;opacity:0.85;">Doctors with Access</div>
                    <div style="font-size:2rem;font-weight:700;">2</div>
                </div>
                <i class="fas fa-user-md fa-2x" style="opacity:0.4;"></i>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header-purple">
                <i class="fas fa-file-medical me-2"></i>My Recent Test Requests
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>Request #</th><th>Date</th><th>Tests</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        <tr>
                            <td><strong>REQ-001</strong></td><td>2026-04-30</td><td>3</td>
                            <td><span class="status-inprogress">In Progress</span></td>
                            <td><a href="/Patient/TestRequests" class="btn btn-sm btn-outline-purple" style="color:#6f42c1;border-color:#6f42c1;">View</a></td>
                        </tr>
                        <tr>
                            <td><strong>REQ-002</strong></td><td>2026-04-29</td><td>2</td>
                            <td><span class="status-released">Results Available</span></td>
                            <td><a href="/Patient/TestRequests" class="btn btn-sm btn-purple">View Results</a></td>
                        </tr>
                        <tr>
                            <td><strong>REQ-003</strong></td><td>2026-04-10</td><td>1</td>
                            <td><span class="status-released">Results Available</span></td>
                            <td><a href="/Patient/TestRequests" class="btn btn-sm btn-purple">View Results</a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card">
            <div class="card-header-purple">
                <i class="fas fa-heartbeat me-2"></i>My Medical Summary
            </div>
            <div class="card-body">
                <p class="mb-2"><strong>Chronic Conditions:</strong></p>
                <p class="mb-3">
                    <span class="badge bg-warning text-dark me-1">Diabetes</span>
                    <span class="badge bg-info me-1">Hypertension</span>
                </p>
                <p class="mb-2"><strong>Allergies:</strong></p>
                <p class="mb-3"><span class="badge bg-danger me-1">Penicillin</span></p>
                <p class="mb-2"><strong>Current Medication:</strong></p>
                <p class="mb-0">Metformin 500mg, Amlodipine 5mg</p>
                <hr />
                <a href="/Patient/MedicalHistory" class="btn btn-sm btn-purple w-100">
                    <i class="fas fa-edit me-1"></i>Update Medical History
                </a>
            </div>
        </div>
    </div>
</div>