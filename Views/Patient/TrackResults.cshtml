@{
    ViewData["Title"] = "Track Results Over Time";
    ViewData["Active"] = "TrackResults";
    Layout = "~/Views/Patient/_PatientLayout.cshtml";
}

<div class="card">
    <div class="card-header-purple">
        <i class="fas fa-chart-line me-2"></i>Track Test Results Over Time
    </div>
    <div class="card-body">
        <div class="row g-3 mb-4 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Test Type</label>
                <select class="form-select">
                    <option selected>Haemoglobin</option>
                    <option>Platelet Count</option>
                    <option>WBC Count</option>
                    <option>PT/INR</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Date From</label>
                <input type="date" class="form-control" value="2026-01-01" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Date To</label>
                <input type="date" class="form-control" value="2026-04-30" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-purple w-100">
                    <i class="fas fa-chart-line me-1"></i>Update Graph
                </button>
            </div>
        </div>

        <!-- Chart Placeholder -->
        <div class="border rounded p-4 mb-4" style="background:#fafafa; min-height:300px; position:relative;">
            <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center; color:#aaa;">
                <i class="fas fa-chart-line fa-4x mb-3"></i>
                <p class="mb-0 fw-semibold">Haemoglobin Trend Graph</p>
                <small>Jan 2026 — Apr 2026</small>
            </div>
            <!-- Simple SVG chart placeholder -->
            <svg width="100%" height="280" viewBox="0 0 700 250" xmlns="http://www.w3.org/2000/svg" style="opacity:0.15;">
                <polyline points="50,200 180,160 300,180 420,120 540,80 660,140"
                    fill="none" stroke="#6f42c1" stroke-width="3" />
                <circle cx="50" cy="200" r="5" fill="#6f42c1"/>
                <circle cx="180" cy="160" r="5" fill="#6f42c1"/>
                <circle cx="300" cy="180" r="5" fill="#6f42c1"/>
                <circle cx="420" cy="120" r="5" fill="#6f42c1"/>
                <circle cx="540" cy="80" r="5" fill="#6f42c1"/>
                <circle cx="660" cy="140" r="5" fill="#6f42c1"/>
            </svg>
        </div>

        <!-- Data Table -->
        <h6 class="fw-semibold mb-3">Haemoglobin Results History</h6>
        <table class="table table-hover">
            <thead><tr><th>Date</th><th>Request #</th><th>Result</th><th>Unit</th><th>Normal Range</th><th>Flag</th></tr></thead>
            <tbody>
                <tr class="abnormal"><td>2026-04-30</td><td>REQ-001</td><td><strong>7.2</strong></td><td>g/dL</td><td>12.0 – 17.5</td><td><span class="badge bg-danger">↓ LOW</span></td></tr>
                <tr><td>2026-03-15</td><td>REQ-004</td><td>10.8</td><td>g/dL</td><td>12.0 – 17.5</td><td><span class="badge bg-warning text-dark">↓ BORDERLINE</span></td></tr>
                <tr><td>2026-02-10</td><td>REQ-005</td><td>12.4</td><td>g/dL</td><td>12.0 – 17.5</td><td><span class="badge bg-success">Normal</span></td></tr>
                <tr><td>2026-01-05</td><td>REQ-006</td><td>13.1</td><td>g/dL</td><td>12.0 – 17.5</td><td><span class="badge bg-success">Normal</span></td></tr>
            </tbody>
        </table>
    </div>
</div>