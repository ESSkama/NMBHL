@{
    ViewData["Title"] = "Create Test Request";
    ViewData["Active"] = "CreateRequest";
    Layout = "~/Views/Doctor/_DoctorLayout.cshtml";
}

<div class="card">
    <div class="card-header-blue">
        <i class="fas fa-file-medical me-2"></i>Create New Test Request
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Patient <span class="text-danger">*</span></label>
                <select class="form-select">
                    <option>Select patient...</option>
                    <option>John Doe (8501015009087)</option>
                    <option>Mary Smith (9203025009081)</option>
                    <option>Peter Jones (7806105009083)</option>
                    <option>Thandi Nkosi (9905105009082)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Request Date <span class="text-danger">*</span></label>
                <input type="date" class="form-control" value="2026-04-30" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Urgency <span class="text-danger">*</span></label>
                <select class="form-select">
                    <option>Routine</option>
                    <option>Urgent</option>
                    <option>STAT</option>
                </select>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Clinical Notes</label>
                <textarea class="form-control" rows="3" placeholder="Enter relevant clinical notes for the lab technician..."></textarea>
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold">Select Test Types <span class="text-danger">*</span></label>
                <div class="border rounded p-3 bg-light">
                    <div class="row g-2">
                        <div class="col-12 mb-1"><strong style="font-size:0.85rem;">Full Blood Count</strong></div>
                        <div class="col-md-3"><div class="form-check"><input class="form-check-input" type="checkbox" id="hb" /><label class="form-check-label" for="hb">Haemoglobin</label></div></div>
                        <div class="col-md-3"><div class="form-check"><input class="form-check-input" type="checkbox" id="plt" /><label class="form-check-label" for="plt">Platelet Count</label></div></div>
                        <div class="col-md-3"><div class="form-check"><input class="form-check-input" type="checkbox" id="rbc" /><label class="form-check-label" for="rbc">RBC Count</label></div></div>
                        <div class="col-md-3"><div class="form-check"><input class="form-check-input" type="checkbox" id="hct" /><label class="form-check-label" for="hct">Haematocrit</label></div></div>

                        <div class="col-12 mt-2 mb-1"><strong style="font-size:0.85rem;">Differential Count</strong></div>
                        <div class="col-md-3"><div class="form-check"><input class="form-check-input" type="checkbox" id="wbc" /><label class="form-check-label" for="wbc">WBC Count</label></div></div>
                        <div class="col-md-3"><div class="form-check"><input class="form-check-input" type="checkbox" id="neut" /><label class="form-check-label" for="neut">Neutrophils</label></div></div>
                        <div class="col-md-3"><div class="form-check"><input class="form-check-input" type="checkbox" id="lymph" /><label class="form-check-label" for="lymph">Lymphocytes</label></div></div>

                        <div class="col-12 mt-2 mb-1"><strong style="font-size:0.85rem;">Coagulation Studies</strong></div>
                        <div class="col-md-3"><div class="form-check"><input class="form-check-input" type="checkbox" id="pt" /><label class="form-check-label" for="pt">PT/INR</label></div></div>
                        <div class="col-md-3"><div class="form-check"><input class="form-check-input" type="checkbox" id="aptt" /><label class="form-check-label" for="aptt">aPTT</label></div></div>

                        <div class="col-12 mt-2 mb-1"><strong style="font-size:0.85rem;">Peripheral Blood Film</strong></div>
                        <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="bfilm" /><label class="form-check-label" for="bfilm">Blood Film Examination</label></div></div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="alert alert-info py-2" style="font-size:0.85rem;">
                    <i class="fas fa-info-circle me-1"></i>
                    <strong>Samples Required:</strong> Based on selected tests — Whole Blood (EDTA Tube), Plasma (Citrate Tube)
                </div>
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold">Sample Barcodes <span class="text-danger">*</span></label>
                <div id="barcodeContainer">
                    <div class="input-group mb-2">
                        <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                        <input type="text" class="form-control" placeholder="Scan or enter barcode" />
                        <button class="btn btn-outline-secondary" onclick="addBarcode()"><i class="fas fa-plus"></i></button>
                    </div>
                </div>
            </div>

            <div class="col-12 d-flex gap-2 justify-content-end">
                <a href="/Doctor/TrackRequests" class="btn btn-secondary">Cancel</a>
                <button class="btn btn-blue"><i class="fas fa-paper-plane me-1"></i>Submit Test Request</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function addBarcode() {
            const container = document.getElementById('barcodeContainer');
            const div = document.createElement('div');
            div.className = 'input-group mb-2';
            div.innerHTML = `
                <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                <input type="text" class="form-control" placeholder="Scan or enter barcode" />
                <button class="btn btn-outline-danger" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>`;
            container.appendChild(div);
        }
    </script>
}