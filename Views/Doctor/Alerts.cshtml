@{
    ViewData["Title"] = "Abnormal Result Alerts";
    ViewData["Active"] = "Alerts";
    Layout = "~/Views/Doctor/_DoctorLayout.cshtml";
}

<div class="card">
    <div class="card-header-blue d-flex justify-content-between align-items-center">
        <span><i class="fas fa-bell me-2"></i>Abnormal Result Alerts</span>
        <span style="font-size:0.85rem; opacity:0.85;">Showing last 5 days by default</span>
    </div>
    <div class="card-body">
        <div class="row mb-3 g-2">
            <div class="col-md-3">
                <label class="form-label fw-semibold" style="font-size:0.8rem;">Date From</label>
                <input type="date" class="form-control" value="2026-04-25" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold" style="font-size:0.8rem;">Date To</label>
                <input type="date" class="form-control" value="2026-04-30" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-blue w-100">Filter</button>
            </div>
        </div>

        <div class="alert alert-danger py-2 mb-3" style="font-size:0.85rem;">
            <i class="fas fa-exclamation-triangle me-1"></i>
            <strong>3 abnormal results</strong> found for your patients in the selected period.
        </div>

        <table class="table table-hover">
            <thead><tr><th>Date</th><th>Request #</th><th>Patient</th><th>Test</th><th>Result</th><th>Normal Range</th><th>Direction</th><th>Action</th></tr></thead>
            <tbody>
                <tr class="abnormal">
                    <td>2026-04-30</td>
                    <td>REQ-001</td>
                    <td>John Doe</td>
                    <td>Haemoglobin</td>
                    <td><strong>7.2 g/dL</strong></td>
                    <td>12.0 – 17.5</td>
                    <td><span class="badge bg-primary">↓ LOW</span></td>
                    <td><a href="/Doctor/Results" class="btn btn-sm btn-blue">View</a></td>
                </tr>
                <tr class="abnormal">
                    <td>2026-04-29</td>
                    <td>REQ-002</td>
                    <td>Mary Smith</td>
                    <td>WBC Count</td>
                    <td><strong>14.5 x10³/µL</strong></td>
                    <td>4.5 – 11.0</td>
                    <td><span class="badge bg-danger">↑ HIGH</span></td>
                    <td><a href="/Doctor/Results" class="btn btn-sm btn-blue">View</a></td>
                </tr>
                <tr class="abnormal">
                    <td>2026-04-27</td>
                    <td>REQ-004</td>
                    <td>Thandi Nkosi</td>
                    <td>Platelet Count</td>
                    <td><strong>89 x10³/µL</strong></td>
                    <td>150 – 400</td>
                    <td><span class="badge bg-primary">↓ LOW</span></td>
                    <td><a href="/Doctor/Results" class="btn btn-sm btn-blue">View</a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>